// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

 
  verifications Verification[]


  games         GamePlayer[]      
  hostedGames   Game[]            @relation("HostGames")
  friends       Friend[]          @relation("UserFriends")
  friendOf      Friend[]          @relation("FriendOf")
  invites       GameInvite[]      @relation("InvitesReceived")
  sentInvites   GameInvite[]      @relation("InvitesSent")
  stats         PlayerStats?

  @@unique([email])
  @@map("user")
}



model Friend {
  id        String   @id @default(uuid())
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  friendId  String
  status    String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
}

model Game {
  id           String      @id @default(uuid())
  code         String      @unique 
  host         User        @relation("HostGames", fields: [hostId], references: [id], onDelete: Cascade)
  hostId       String
  status       String      
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  expiresAt    DateTime
  rounds       Int
  currentTurn Int @default(0)
  currentRound Int
  settings     Json        
  players      GamePlayer[]
  invites      GameInvite[]
  actions      GameAction[]
  votes        Vote[]
  centerCards  CenterCard[]
}

model GamePlayer {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  role      Role?     @relation(fields: [roleId], references: [id])
  roleId    String?   
  isReady   Boolean  @default(false)
  eliminated Boolean @default(false)
  joinedAt  DateTime @default(now())

  votesCast   Vote[] @relation("Voter")
  votesReceived Vote[] @relation("VotedFor")
  actions      GameAction[] @relation("GamePlayerActions")
}

model GameInvite {
  id          String   @id @default(uuid())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId      String
  sender      User     @relation("InvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  recipient   User     @relation("InvitesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  status      String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String        @id @default(uuid())
  name        String        @unique 
  description String
  ability     String
  image       String
  gamePlayers GamePlayer[]  
  centerCards CenterCard[] 
}

model GameAction {
  id        String   @id @default(uuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    GamePlayer @relation("GamePlayerActions", fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  round     Int
  action    String   
  target    String?  
  createdAt DateTime @default(now())
}

model CenterCard {
  id     String @id @default(uuid())
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String
  position Int  
}

model Vote {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  voter     GamePlayer @relation("Voter", fields: [voterId], references: [id], onDelete: Cascade)
  voterId   String
  votedFor  GamePlayer @relation("VotedFor", fields: [votedForId], references: [id], onDelete: Cascade)
  votedForId String
  round     Int
  createdAt DateTime @default(now())
}

model PlayerStats {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  gamesPlayed    Int      @default(0)
  gamesWon       Int      @default(0)
  gamesLost      Int      @default(0)
  saboteurGames  Int      @default(0)
  saboteurWins   Int      @default(0)
  mostPlayedRole String?
}


model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification")
}